class Solution {
    HashSet<Integer> h = new HashSet<>();
    public boolean findTarget(TreeNode root, int k)
    {
        if(root==null)
        {
            return false;
        }
        if(h.contains(k-(root.val)))
        {
            return true;
        }
        h.add(root.val);
        return findTarget(root.left,k) || findTarget(root.right,k);
    }
}
