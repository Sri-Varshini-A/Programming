class Solution {
    private ArrayList<Integer> list = new ArrayList<>();
    public int kthSmallest(TreeNode root, int k) {
        inorder(root,k);
        return list.get(k-1);
    }
    private void inorder(TreeNode root, int k)
    {
        if(root==null)
        {
            return;
        }

        inorder(root.left,k);
 
        if(list.size() == k)
        {
            return;
        }
        list.add(root.val);

        inorder(root.right,k);
    }
}
